---
import { site } from '~/data/site';
import { services, primaryNav } from '~/data/nav';

/** Текущий раздел — чтобы подсветить пункт меню и не давать ссылку на себя. */
const here = Astro.url.pathname;
const isHere = (href: string) => here === href;
---

<div class="bar">
  <div class="wrap">
    <a class="logo" href="/">
      {site.brand.short}
      <span>{site.brand.where}</span>
    </a>

    <nav aria-label="Основная навигация">
      <span class="drop" tabindex="0">
        <b>Услуги</b>
        <menu>
          {services.map((s) => <a href={s.href}>{s.label}</a>)}
        </menu>
      </span>

      {
        primaryNav.map((item) => (
          <a href={item.href} aria-current={isHere(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }

      <a class="tel" href={`tel:${site.phone.tel}`}>{site.phone.label}</a>
      <a class="btn" href="/zakaz/">Заказать</a>
    </nav>
  </div>
</div>
